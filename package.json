{
  "name": "andes-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "node dist/server.js",
    "migrate": "node scripts/migrate.mjs",
    "worker:control": "node dist/worker.js control",
    "worker:emergency": "node dist/worker.js emergency",
    "worker:ordinary": "node dist/worker.js ordinary",
    "bootstrap": "node scripts/bootstrap.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "infra:check": "node --test tests/infra.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1152.0",
    "fastify": "5.12.7",
    "jose": "6.1.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3"
  }
}

# Inject credentials through your secret manager; never commit populated env files.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/andes
OIDC_ISSUER=https://YOUR-TRUSTED-ISSUER
OIDC_AUDIENCE=YOUR-API-AUDIENCE
OIDC_JWKS_URL=https://YOUR-TRUSTED-ISSUER/.well-known/jwks.json
PORT=3000
# Tests require a disposable PostgreSQL database and create/drop unique schemas.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/andes_test
# No live sending or synthetic identity/provider startup defaults exist.

# Three separate ECS roles; queues are Standard, each with its own DLQ.
AWS_REGION=YOUR-AWS-REGION
SQS_EMERGENCY_URL=https://sqs.REGION.amazonaws.com/ACCOUNT/andes-emergency
SQS_ORDINARY_URL=https://sqs.REGION.amazonaws.com/ACCOUNT/andes-ordinary
# Defaults to disabled. Even zv_test_ keys send real WhatsApp; never use keys in tests.
ZAVU_LIVE_SEND=false
# Secrets Manager injects these only after sender/country/channel/template qualification.
# ZAVU_API_KEY=
# ZAVU_PROJECT_ID=
# ZAVU_SENDER_ID=
# ZAVU_CALLBACK_SECRET=
# ZAVU_QUALIFICATION_JSON= (see docs/contracts/runtime.md; no qualification defaults)

# AWS uses raw secret components instead of DATABASE_URL (unset that variable).
# PGHOST=the-real-rds-endpoint
# PGPORT=5432
# PGDATABASE=andes
# PGUSER= (ECS Secrets: AppSecret username)
# PGPASSWORD= (ECS Secrets: AppSecret password)
# PGSSLROOTCERT=/app/infra/rds-global-bundle.pem
# Do not set PGSSLMODE or URL ssl* options with verified CA configuration.
# One-off bootstrap alone receives admin PGUSER/PGPASSWORD and APP_PGUSER/APP_PGPASSWORD.
